# Cadena de conexión de PostgreSQL. En Render se configura en Environment Variables.
# En Supabase usa Connect -> Transaction pooler (o Session pooler) y copia la cadena
# completa. El host depende de la región del proyecto y el usuario es postgres.<project-ref>.
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Déjalo vacío o en true para Supabase. Usa false solo con un Postgres local sin SSL.
DATABASE_SSL=true

# Puerto del servidor Node en local. Render inyecta PORT automáticamente.
PORT=3001

# En Render se define NODE_ENV=production. En local puedes dejarlo sin definir.
# NODE_ENV=production
